{
  "manifest_version": 3,
  "name": "UPGW - Universal Web Personalizer",
  "version": "1.0.0",
  "description": "Chat-driven safe webpage personalization and readability enhancements.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "UPGW Personalizer"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
