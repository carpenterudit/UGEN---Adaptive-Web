# Environment variables for UPGW Backend
# Copy this to .env and fill in real values

# App settings
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./upgw.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost/upgw

# CORS
FRONTEND_URL=http://localhost:5173

# AI Provider (optional - app runs in demo mode without this)
AI_PROVIDER=demo
# Options: demo, openai, anthropic, google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Extension
EXTENSION_SECRET=change-this-extension-secret
