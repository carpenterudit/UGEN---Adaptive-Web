# Environment variables for UGEN — Universal Personalized Generative Web
# Copy to backend/.env for backend, and configure in Vercel / Render project settings

# Backend Settings
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
DEBUG=true

# Database:
# Local Development:
DATABASE_URL=sqlite:///./upgw.db
# Production (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# CORS Configuration
FRONTEND_URL=https://spiffy-medovik-e89e10.netlify.app/
# Production Frontend URL:
# FRONTEND_URL=https://spiffy-medovik-e89e10.netlify.app/

# AI Engine Settings (Demo mode active by default, zero API key required)
AI_PROVIDER=demo
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Chrome MV3 Extension
EXTENSION_SECRET=dev-extension-secret-change-in-prod

# Frontend Settings (Vite / Vercel Environment Variables)
# Local:
VITE_API_URL=https://your-backend.onrender.com/api/v1
# Production (set in Vercel Project Settings > Environment Variables):
# VITE_API_URL=https://ugen-backend.onrender.com/api/v1
