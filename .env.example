# Environment variables for UPGW
# Copy to .env for backend or frontend/.env for frontend

# Backend Settings
APP_ENV=development
SECRET_KEY=dev-secret-key-upgw-2026
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./upgw.db
FRONTEND_URL=http://localhost:5173

# AI Settings (Demo mode active by default, no API key required)
AI_PROVIDER=demo
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Extension
EXTENSION_SECRET=dev-extension-secret

# Frontend Settings (Vite)
VITE_API_URL=http://127.0.0.1:8000/api/v1
